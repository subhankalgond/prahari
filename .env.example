# ==============================================================
# Prahari - environment configuration
# Copy this file to .env at the project root and fill in values.
# Never commit real secrets.
# ==============================================================

# --- Application ---------------------------------------------
NODE_ENV=development
# Public site URL, used for SEO tags, sitemap and image URLs
PUBLIC_SITE_URL=https://prahari.in

# --- Backend --------------------------------------------------
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Secrets: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRES_IN=7d

# Set to true to run with in-memory demo data and no external
# services (database, weather API, AI model). The UI shows a
# visible "Demo data" badge in this mode.
DEMO_MODE=true

# --- Database (production mode, DEMO_MODE=false) --------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prahari

# --- Supabase (optional: managed Postgres + auth + storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=crop-images
ADMIN_EMAIL=admin@prahari.in
ADMIN_PASSWORD=
ADMIN_MOBILE=+919999000001

# --- Weather --------------------------------------------------
# Leave empty to use the clearly-labelled demo weather provider.
WEATHER_API_KEY=
WEATHER_PROVIDER=demo

# --- AI service ----------------------------------------------
# demo  -> deterministic demo analysis provider (no model needed)
# model -> call the FastAPI ai-service at AI_SERVICE_URL
AI_PROVIDER=demo
AI_SERVICE_URL=http://localhost:8000

# --- Frontend (frontend/.env.local) ---------------------------
VITE_API_URL=http://localhost:4000

# --- Keep-alive (production only) ----------------------------
# Deployed backend URL. Used by the self-ping cron job (every 10 min)
# to prevent the Render free-tier container from sleeping.
# Example: https://kisanconnect-api.onrender.com
# Leave empty in local development — the cron is automatically disabled.
BACKEND_URL=
